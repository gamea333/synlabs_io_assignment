# Judge and generator are configured INDEPENDENTLY (different endpoints/keys/models allowed).
# Default: judge = gpt-oss-120b (OpenAI family), generator = qwen3.8-27b (Alibaba family) -> no self-enhancement.
# (Roles were swapped from the first design: Groq caps Qwen at 1,000 OUTPUT tokens/min, too low for an
#  evidence-quoting judge, while generator outputs are short.)
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_TEMPERATURE=0.0

GENERATOR_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_API_KEY=
GENERATOR_MODEL=qwen/qwen3.8-27b
GENERATOR_TEMPERATURE=0.3

# Every judge/generator call (prompt, raw response, tokens, latency) is appended here.
# It doubles as a response cache keyed by request hash, so runs are replayable for free.
CALL_LOG=logs/calls.jsonl
