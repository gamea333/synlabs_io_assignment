# --- LLM (any OpenAI-compatible endpoint) ---
# Groq (default):   https://api.groq.com/openai/v1
# Ollama (local):   http://localhost:11434/v1   (LLM_API_KEY can be any string)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Judge model for answer evaluation (different/bigger model than generator)
JUDGE_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, via fastembed/ONNX) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking defaults ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
TOP_K=5
# min cosine similarity for a chunk to count as relevant context
MIN_SCORE=0.55

# --- Storage ---
LANCEDB_URI=data/lancedb
LANCEDB_TABLE=chunks
LOG_PATH=logs/queries.jsonl
